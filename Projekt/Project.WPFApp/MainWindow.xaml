<Window x:Class="Project.WPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.WPFApp"
        mc:Ignorable="d"
        Title="Okno główne" Height="1050" Width="1000" Background="Blue">
    <Grid>
        <Viewbox>
            <StackPanel Margin="10">
                <Label Content="System zarządzania pracownikami" Height="29" Width="273" FontSize="15" FontWeight="Bold" Foreground="GreenYellow" HorizontalContentAlignment="Center" />
                <TextBlock/>

                <Button Content="1. Pokaż szefa i pracowników" Background="DarkCyan" Margin="-16,10,10,1" Width="159" Command="{Binding PokazPracownikowCommand}"/>

                <Button Content="2. Zatrudnij nowego pracownika" Background="DarkCyan" Margin="0,10,10,5" Width="176" Command="{Binding ZatrudnijPracownikaCommand}"/>

                <Button Content="3. Zrób wypłaty pracownikom" Background="DarkCyan" Margin="-23,5,1,5" Width="162" Command="{Binding ZrobWyplatyCommand}" />

                <Button Content="4. Znajdź najlepszego pracownika" Background="DarkCyan" Margin="-2,5,1,5" Width="184" Command="{Binding ZnajdzNajlepszyCommand}"/>

                <Button Content="5. Zwolnij pracownika" Background="DarkCyan" Margin="-65,5,1,10" Width="120" Command="{Binding ZwolnijPracownikaCommand}"/>

                <Button Content="*Wybierz z powyższych opcji*" FontSize="8" Background="SlateGray" Margin="-50,10,10,10" Width="108" HorizontalContentAlignment="Left" />
                
                <Button Content="Wyjście" Margin="-130,10,10,10" Width="49" Background="IndianRed" Command="{Binding WyjscieCommand}"></Button>



            </StackPanel>
        </Viewbox>
    </Grid>
</Window>
