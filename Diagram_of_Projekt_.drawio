        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class User {\n        &lt;&lt;abstract&gt;&gt;\n        +int Id\n        +string FullName\n        +string Phone\n        +string Email\n        +GetContactInfo() string\n    }\n\n    class Client {\n        +List~Order~ OrdersHistory\n        +CreateOrder(Device device) Order\n        +GetActiveOrders() List~Order~\n        +GetOrderHistory() List~Order~\n    }\n\n    class Technician {\n        +string Specialization\n        +bool IsBusy\n        +List~Order~ AssignedOrders\n        +DiagnoseDevice(Device device) string\n        +RepairDevice(Order order) bool\n        +CompleteOrder(Order order) void\n    }\n\n    class ServiceCenter {\n        +int Id\n        +string City\n        +string Address\n        +List~Technician~ Staff\n        +List~SparePart~ Inventory\n        +AddTechnician(Technician tech) void\n        +RemoveTechnician(int techId) bool\n        +GetAvailableTechnician() Technician\n        +AddSparePart(SparePart part) void\n    }\n\n    class Device {\n        +string SerialNumber\n        +string Model\n        +string IssueDescription\n        +DeviceType Type\n        +GetFullInfo() string\n        +UpdateIssueDescription(string newDesc) void\n    }\n\n    class Order {\n        +int OrderId\n        +DateTime CreatedAt\n        +DateTime? CompletedAt\n        +OrderStatus Status\n        +decimal LaborCost\n        +Client Client\n        +Technician Technician\n        +Device Device\n        +List~SparePart~ UsedParts\n        +UpdateStatus(OrderStatus newStatus) void\n        +AddUsedPart(SparePart part) void\n        +CalculateTotal() decimal\n        +GenerateReceipt() string\n    }\n\n    class SparePart {\n        +int PartId\n        +string Name\n        +decimal Price\n        +int QuantityInStock\n        +DeductStock(int quantity) bool\n        +Restock(int quantity) void\n    }\n\n    User &lt;|-- Client\n    User &lt;|-- Technician\n    ServiceCenter \&quot;1\&quot; o-- \&quot;*\&quot; Technician\n    ServiceCenter \&quot;1\&quot; *-- \&quot;*\&quot; SparePart\n    Client \&quot;1\&quot; -- \&quot;*\&quot; Order\n    Technician \&quot;1\&quot; -- \&quot;*\&quot; Order\n    Order \&quot;1\&quot; *-- \&quot;1\&quot; Device\n    Order \&quot;*\&quot; -- \&quot;*\&quot; SparePart&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="m8Lq8QPp_PVlDjVgUIcn-284">
