<Window x:Class="Hotel.UI.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel.UI.WpfApp"
        xmlns:viewmodels="clr-namespace:Hotel.UI.WpfApp.ViewModels"
        mc:Ignorable="d"
        Title="Hotel" Height="450" Width="800">
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">

            <MenuItem Header="_Rooms">
                <MenuItem Header="Add..." Command="{Binding AddRoomCommand}"/>
                <MenuItem Header="Edit..." Command="{Binding EditRoomCommand}"/>
                <MenuItem Header="Delete" Command="{Binding DeleteRoomCommand}"/>
                <Separator/>
                <MenuItem Header="Show all" Command="{Binding PrintRoomsCommand}"/>
            </MenuItem>
            <!-- itd. -->
        </Menu>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}"/>
    </DockPanel>
</Window>
