<Window x:Class="Calculator.UI.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

        xmlns:local="clr-namespace:Calculator.UI.WpfApp"
        xmlns:viewmodels="clr-namespace:Calculator.UI.WpfApp.ViewModels"
        Title="Calculator" Height="300" Width="250">

    <Window.DataContext>
        <viewmodels:CalculatorViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>

    <Viewbox>
        <Grid Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Row="0" Grid.ColumnSpan="4"
                     Text="{Binding Display}" FontSize="36" IsReadOnly="True"
                     FontWeight="Bold" Padding="15" TextAlignment="Right"
                     VerticalContentAlignment="Center" Margin="5 0 5 10"/>

            <Button Grid.Row="1" Grid.Column="0" Content="1"
                Command="{Binding IncludeSignCommand}" CommandParameter="1"/>
            <Button Grid.Row="1" Grid.Column="1" Content="2"
                Command="{Binding IncludeSignCommand}" CommandParameter="2"/>
            <Button Grid.Row="1" Grid.Column="2" Content="3"
                Command="{Binding IncludeSignCommand}" CommandParameter="3"/>
            <Button Grid.Row="2" Grid.Column="0" Content="4"
                Command="{Binding IncludeSignCommand}" CommandParameter="4"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5"
                Command="{Binding IncludeSignCommand}" CommandParameter="5"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6"
                Command="{Binding IncludeSignCommand}" CommandParameter="6"/>
            <Button Grid.Row="3" Grid.Column="0" Content="7"
                Command="{Binding IncludeSignCommand}" CommandParameter="7"/>
            <Button Grid.Row="3" Grid.Column="1" Content="8"
                Command="{Binding IncludeSignCommand}" CommandParameter="8"/>
            <Button Grid.Row="3" Grid.Column="2" Content="9"
                Command="{Binding IncludeSignCommand}" CommandParameter="9"/>
            <Button Grid.Row="4" Grid.Column="1" Content="0"
                Command="{Binding IncludeSignCommand}" CommandParameter="0"/>


            <Button Grid.Row="1" Grid.Column="3" Content="+"
                Command="{Binding SetOperationCommand}" CommandParameter="+"/>
            <Button Grid.Row="2" Grid.Column="3" Content="-"
                Command="{Binding SetOperationCommand}" CommandParameter="-"/>
            <Button Grid.Row="3" Grid.Column="3" Content="*"
                Command="{Binding SetOperationCommand}" CommandParameter="*"/>
            <Button Grid.Row="4" Grid.Column="3" Content="/"
                Command="{Binding SetOperationCommand}" CommandParameter="/"/>
            <Button Grid.Row="5" Grid.Column="3" Content="√"
                Command="{Binding SetOperationCommand}" CommandParameter="sqrt"/>
            <Button Grid.Row="5" Grid.Column="2" Content="²"
                Command="{Binding SetOperationCommand}" CommandParameter="pow"/>
            
            <Button Grid.Row="4" Grid.Column="0" Content=","
                Command="{Binding IncludeSignCommand}" CommandParameter=","/>
            <Button Grid.Row="4" Grid.Column="2" Content="+/-"
                Command="{Binding ChangeSignCommand}"/>
            <Button Grid.Row="5" Grid.Column="0" Content="="
                Command="{Binding CalculateResultCommand}" CommandParameter="="/>
            <Button Grid.Row="5" Grid.Column="1" Content="C"
                Command="{Binding ResetCommand}"/>


        </Grid>
    </Viewbox>

</Window>
