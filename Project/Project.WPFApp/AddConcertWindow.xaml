<Window x:Class="Project.WPFApp.AddConcertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.WPFApp"
        mc:Ignorable="d"
        Title="Dodawanie koncertu" Height="250" Width="300">
    <StackPanel Margin="10">
        <Label Content="Wybierz Artystę:"/>
        <ComboBox ItemsSource="{Binding DostepniArtysci}"
                  SelectedItem="{Binding WybranyArtysta}"
                  DisplayMemberPath="Name"/>

        <Label Content="Wybierz Lokal:"/>
        <ComboBox ItemsSource="{Binding DostepneLokale}"
                  SelectedItem="{Binding WybranyLokal}"/>

        <Label Content="Data:"/>
        <DatePicker SelectedDate="{Binding Data}"/>
        <Button Content="Dodaj" Command="{Binding DodajCommand}" Margin="0,10,0,0"/>
    </StackPanel>
</Window>
