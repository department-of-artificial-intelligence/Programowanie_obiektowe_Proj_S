<Window x:Class="Project.WPFApp.Windows.CreateHotelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Project.WPFApp.Windows"
        xmlns:vm="clr-namespace:Project.WPFApp.ViewModels"
        mc:Ignorable="d"
        Title="Create Hotel" Height="175" Width="400">
    
    <Window.DataContext>
        <vm:CreateHotelViewModel />
    </Window.DataContext>
    
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <ScrollViewer.Resources>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="4,4,4,8" />
                </Style>
            </ScrollViewer.Resources>

            <StackPanel Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Hotel Name" />
                    <TextBox Grid.Column="1" Text="{Binding Name}" IsEnabled="{Binding IsCanBeCreated}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Hotel Address" />
                    <TextBox Grid.Column="1" Text="{Binding Address}" IsEnabled="{Binding IsCanBeCreated}" />
                </Grid>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Manager" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableManagers}" SelectedItem="{Binding Manager}" IsEnabled="{Binding IsCanBeCreated}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1} ({2})">
                                            <Binding Path="Person.FirstName" />
                                            <Binding Path="Person.LastName" />
                                            <Binding Path="Person.DateOfBirth" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <Button Margin="4" Grid.Column="1" Content="Create" Command="{Binding CreateHotelCommand}" IsEnabled="{Binding IsCanBeCreated}" />
        </Grid>
    </Grid>
</Window>
