<Window x:Class="Project.WPFApp.Windows.DatabaseConnectionWindow"
        x:Name="DatabaseConnectionWindowElement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.WPFApp.Windows"
        xmlns:vm="clr-namespace:Project.WPFApp.ViewModels"
        mc:Ignorable="d"
        Title="SQL Server" Height="240" Width="360" MinHeight="100" MinWidth="240" MaxHeight="720" MaxWidth="1024">

    <Window.DataContext>
        <vm:DatabaseConnectionViewModel />
    </Window.DataContext>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabControl.Resources>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="4,4,4,8" />
                </Style>
            </TabControl.Resources>
            
            <TabItem Header="Simple">
                <ScrollViewer>
                    <StackPanel Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Server Name" />
                            <TextBox Grid.Column="1" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Database Name" />
                            <TextBox Grid.Column="1" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Parameters" />
                            <TextBox Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Connection String">
                <StackPanel Orientation="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Connection String" />
                        <TextBox Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <CheckBox Margin="4" Grid.Column="0" VerticalAlignment="Center" Content="Save connection string" />
            <Button Margin="4" Grid.Column="1" Grid.Row="1" Content="Connect" />
        </Grid>
    </Grid>
</Window>
