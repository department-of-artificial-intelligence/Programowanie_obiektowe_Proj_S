<Window x:Class="Project.WPFApp.AddArtistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.WPFApp"
        mc:Ignorable="d"
        Title="Dodawanie artysty" Height="250" Width="300">
    <StackPanel Margin="10">
        <Label Content="Nazwa artysty:"/>
        <TextBox Text="{Binding Nazwa,UpdateSourceTrigger=PropertyChanged}"/>

        <Label Content="Gatunek:"/>
        <TextBox Text="{Binding Gatunek,UpdateSourceTrigger=PropertyChanged}"/>

        <Label Content="Kraj:"/>
        <TextBox Text="{Binding Kraj,UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="Dodaj" Command="{Binding DodajCommand}" Margin="0,10,0,0"/>
    </StackPanel>
    
    

    
</Window>
