<Window x:Class="Project.WPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.WPFApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Canvas>
        <TextBox   TextWrapping="Wrap" Text="Nazwa lokalu" Width="120" RenderTransformOrigin="-1.15,2.86" HorizontalAlignment="Center" Canvas.Top="19" VerticalAlignment="Center" Height="18"/>
        <TextBox TextWrapping="Wrap" Text="Miasto" Width="120" HorizontalAlignment="Left" Canvas.Left="137" VerticalAlignment="Top" Canvas.Top="19"/>
        <TextBox TextWrapping="Wrap" Text="Pojemność" Width="120" HorizontalAlignment="Left" Canvas.Left="280" VerticalAlignment="Top" Canvas.Top="19" TextAlignment="Right" TextChanged="TextBox_TextChanged"/>
        <Button Content="Dodaj lokal" Canvas.Left="441" Canvas.Top="20" RenderTransformOrigin="-0.188,1.622" HorizontalAlignment="Left" VerticalAlignment="Center" Width="108"/>
        
        <TextBox   TextWrapping="Wrap" Text="Imię" Width="120" RenderTransformOrigin="-1.15,2.86" Canvas.Top="65" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <TextBox TextWrapping="Wrap" Text="Nazwisko" Width="120" Canvas.Left="137" Canvas.Top="65" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <TextBox TextWrapping="Wrap" Text="Wiek" Width="120" Canvas.Left="280" Canvas.Top="65" TextAlignment="Right" TextChanged="TextBox_TextChanged" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Button Content="Dodaj Osobę" Canvas.Left="441" Canvas.Top="66" RenderTransformOrigin="-0.188,1.622" Width="108" HorizontalAlignment="Center" VerticalAlignment="Top"/>


    </Canvas>
</Window>
