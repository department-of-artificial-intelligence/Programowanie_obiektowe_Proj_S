<Window x:Class="Project.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View"
        mc:Ignorable="d"
        Title="Drivers" Height="450" Width="800">
    <Grid>
        <Button x:Name="ButtonAddDriverWindowShow" Content="Add driver" HorizontalAlignment="Left" Margin="29,84,0,0" VerticalAlignment="Center"/>
        <Button x:Name="ButtonDeleteDriverWindowShow" Content="Delete driver" HorizontalAlignment="Left" Margin="377,84,0,0" VerticalAlignment="Center"/>
        <DockPanel Height="268" LastChildFill="False" Margin="10,0,9" VerticalAlignment="Bottom">
            <DataGrid x:Name="dataGridDrivers" ItemsSource="{Binding Drivers, Mode=TwoWay}" AutoGenerateColumns="False" DockPanel>
                
            </DataGrid>
        </DockPanel>
        "
    </Grid>
</Window>
