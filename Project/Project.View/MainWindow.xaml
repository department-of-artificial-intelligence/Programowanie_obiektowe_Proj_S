<Window x:Class="Project.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project.View"
        xmlns:viewModel="clr-namespace:Project.ViewModel;assembly=Project.ViewModel"
        mc:Ignorable="d"
        Title="Drivers" Height="450" Width="800">
    <Grid>
        <Button x:Name="ButtonAddDriverWindowShow" Content="Add driver" HorizontalAlignment="Left" Margin="29,84,0,0" VerticalAlignment="Top" Width="150" Height="50" RenderTransformOrigin="0.152, 1.332" Grid.ColumnSpan="2" Command="{Binding Path=ShowAddDirverWindowCommand}"/>
        <Button x:Name="ButtonDeleteDriverWindowShow" Content="Delete driver" HorizontalAlignment="Left" Margin="377,84,0,0" VerticalAlignment="Top" Width="150" Height="50" Command="{Binding Path=DeleteDriverCommandS}"/>
        <DockPanel Height="268" LastChildFill="False" Margin="10,0,0,9" VerticalAlignment="Bottom">
            <DataGrid x:Name="dataGridDrivers" ItemsSource="{Binding Drivers, Mode=TwoWay}" AutoGenerateColumns="False" DockPanel.Dock="Bottom" Height="275" VerticalAlignment="Top" Margin="10,0,9.4,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="First name" Binding="{Binding FirstName}"/>
                    <DataGridTextColumn Header="Last name" Binding="{Binding LastName}"/>
                    <DataGridTextColumn Header="License number" Binding="{Binding LicenseNumber}"/>
                    <DataGridTextColumn Header="Orders" Binding="{Binding Orders}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <Button x:Name="ButtonAddOrderWindow" Content="Add order" HorizontalAlignment="Left" Margin="203,84,0,0" VerticalAlignment="Top" Width="150" Height="50" Command="{Binding Path=ShowAddOrderWindowCommand}"/>

    </Grid>
</Window>
