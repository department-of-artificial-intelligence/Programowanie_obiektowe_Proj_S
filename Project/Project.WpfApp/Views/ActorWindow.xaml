<Window x:Class="Project.WpfApp.Views.ActorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Project.WpfApp.ViewModels" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        Title="Actor" 
        Height="500" 
        Width="450"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ColoredGroupBox" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#F0F8FF"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,8,5,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15">

                <StackPanel>
                    <TextBlock Text="Actor Information" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <Border Height="2" Background="#0078D4" Margin="0,0,0,15"/>
                </StackPanel>

                <GroupBox Header="Personal Information" Style="{StaticResource ColoredGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="First Name:"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Actor.FirstName}"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Last Name:"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Actor.LastName}"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Nationality:"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Actor.Nationality}"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Birth Date:"/>
                        <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding Actor.BirthDate}"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="Profile Image URL:"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Actor.ProfileImageUrl}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Professional Information" Style="{StaticResource ColoredGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Biography:"/>
                        <TextBox Grid.Row="0" Grid.Column="1" 
                               Text="{Binding Actor.Biography}" 
                               Height="80" 
                               TextWrapping="Wrap"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Popularity:"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Actor.Popularity}"/>
                    </Grid>
                </GroupBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Confirm" 
                            Width="100"
                            Height="35"
                            Background="#0078D4"
                            Foreground="White"
                            FontWeight="Bold"
                            Command="{Binding ConfirmCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="Close" 
                            Width="100"
                            Height="35"
                            Background="#6C757D"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="10,0,0,0"
                            Command="{Binding CloseCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>