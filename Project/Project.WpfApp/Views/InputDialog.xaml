<Window x:Class="Project.WpfApp.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter" 
        Height="300" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15">

                <StackPanel>
                    <TextBlock Text="Filter Input" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <Border Height="2" Background="#0078D4" Margin="0,0,0,15"/>
                </StackPanel>

                <GroupBox Header="Enter Filter Criteria" Style="{StaticResource ColoredGroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="lblQuestion" 
                                   Grid.Row="0" 
                                   Margin="5" 
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtAnswer" 
                                 Grid.Row="1" 
                                 Margin="5" 
                                 Height="25"/>
                    </Grid>
                </GroupBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="OK" 
                            Width="100"
                            Height="35"
                            Background="#0078D4"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnDialogOk_Click" 
                            IsDefault="True"/>
                    <Button Content="Cancel" 
                            Width="100"
                            Height="35"
                            Background="#6C757D"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="10,0,0,0"
                            Click="BtnDialogCancel_Click" 
                            IsCancel="True"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>