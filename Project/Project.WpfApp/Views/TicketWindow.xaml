<Window x:Class="Project.WpfApp.Views.TicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticket" 
        Height="500" 
        Width="550"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15">
                
                <StackPanel>
                    <TextBlock Text="Ticket Details" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <Border Height="2" Background="#0078D4" Margin="0,0,0,15"/>
                </StackPanel>

                <GroupBox Header="Ticket Information" Style="{StaticResource ColoredGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Reservation:"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" 
                                ItemsSource="{Binding AvailableReservations}" 
                                SelectedValue="{Binding Ticket.ReservationId}"
                                SelectedValuePath="Id"
                                DisplayMemberPath="CustomerFullName"
                                Margin="5"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Cinema:"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" 
                                ItemsSource="{Binding AvailableCinemas}" 
                                SelectedValue="{Binding Ticket.CinemaId}"
                                SelectedValuePath="Id"
                                DisplayMemberPath="Name"
                                Margin="5"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Auditorium:"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" 
                                ItemsSource="{Binding AvailableAuditoriums}" 
                                SelectedValue="{Binding Ticket.AuditoriumId}"
                                SelectedValuePath="Id"
                                DisplayMemberPath="Name"
                                Margin="5"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Seance:"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" 
                                ItemsSource="{Binding AvailableSeances}" 
                                SelectedValue="{Binding Ticket.SeanceId}"
                                SelectedValuePath="Id"
                                DisplayMemberPath="StartTime"
                                Margin="5"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="Film:"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" 
                                ItemsSource="{Binding AvailableFilms}" 
                                SelectedValue="{Binding Ticket.FilmId}"
                                SelectedValuePath="Id"
                                DisplayMemberPath="Title"
                                Margin="5"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="Seat ID:"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Ticket.SeatId}"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="Original Price:"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Ticket.OriginalPrice}"/>

                        <Label Grid.Row="7" Grid.Column="0" Content="Ticket Type:"/>
                        <ComboBox Grid.Row="7" Grid.Column="1" 
                                ItemsSource="{Binding AvailableTicketTypes}" 
                                SelectedItem="{Binding Ticket.Type}"
                                Margin="5"/>
                    </Grid>
                </GroupBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Confirm" 
                            Width="100"
                            Height="35"
                            Background="#0078D4"
                            Foreground="White"
                            FontWeight="Bold"
                            Command="{Binding ConfirmCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="Close" 
                            Width="100"
                            Height="35"
                            Background="#6C757D"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="10,0,0,0"
                            Command="{Binding CloseCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>