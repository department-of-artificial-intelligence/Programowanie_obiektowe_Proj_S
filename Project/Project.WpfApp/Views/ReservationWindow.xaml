<Window x:Class="Project.WpfApp.Views.ReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservation" 
        Height="450" 
        Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15">

                <StackPanel>
                    <TextBlock Text="Reservation Details" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <Border Height="2" Background="#0078D4" Margin="0,0,0,15"/>
                </StackPanel>

                <GroupBox Header="Customer Information" Style="{StaticResource ColoredGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Seance:"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" 
                                ItemsSource="{Binding AvailableSeances}" 
                                SelectedValue="{Binding Reservation.SeanceId}"
                                SelectedValuePath="Id"
                                DisplayMemberPath="StartTime"
                                Margin="5"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="First Name:"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Reservation.CustomerFirstName}"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Last Name:"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Reservation.CustomerLastName}"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Email:"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Reservation.CustomerEmail}"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="Phone:"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Reservation.CustomerPhone}"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="Payment Method:"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" 
                                ItemsSource="{Binding PaymentMethods}" 
                                SelectedItem="{Binding Reservation.PaymentMethod}"
                                Margin="5"/>
                    </Grid>
                </GroupBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Confirm" 
                            Width="100"
                            Height="35"
                            Background="#0078D4"
                            Foreground="White"
                            FontWeight="Bold"
                            Command="{Binding ConfirmCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="Close" 
                            Width="100"
                            Height="35"
                            Background="#6C757D"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="10,0,0,0"
                            Command="{Binding CloseCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>