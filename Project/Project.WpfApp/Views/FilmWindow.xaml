<Window x:Class="Project.WpfApp.Views.FilmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Film" 
        Height="550" 
        Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15">

                <StackPanel>
                    <TextBlock Text="Film Details" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <Border Height="2" Background="#0078D4" Margin="0,0,0,15"/>
                </StackPanel>

                <GroupBox Header="Film Information" Style="{StaticResource ColoredGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Title:"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Film.Title}"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Description:"/>
                        <TextBox Grid.Row="1" Grid.Column="1" 
                               Text="{Binding Film.Description}" 
                               Height="60" 
                               TextWrapping="Wrap"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Duration (minutes):"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Film.DurationMinutes}"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Director:"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Film.Director}"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="Genre:"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Film.Genre}"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="Age Restriction:"/>
                        <CheckBox Grid.Row="5" Grid.Column="1" 
                                IsChecked="{Binding Film.HasAgeRestriction}"
                                Margin="5"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="Poster URL:"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Film.PosterUrl}"/>

                        <Label Grid.Row="7" Grid.Column="0" Content="Trailer URL:"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Film.TrailerUrl}"/>
                    </Grid>
                </GroupBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Confirm" 
                            Width="100"
                            Height="35"
                            Background="#0078D4"
                            Foreground="White"
                            FontWeight="Bold"
                            Command="{Binding ConfirmCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="Close" 
                            Width="100"
                            Height="35"
                            Background="#6C757D"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="10,0,0,0"
                            Command="{Binding CloseCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>