<Window x:Class="Project.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Project.UI.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="520" Width="950">
    
    <Window.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:FirstLetterConverter x:Key="FirstLetterConverter"/>
    </Window.Resources>
    
    <DockPanel>
        <TabControl>
            <TabItem Header="Explore Movies">
                <!-- First tab with movies and filters -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            BorderBrush="Black"
                            BorderThickness="0, 0, 1.5, 0"
                    >
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Label Content="Filters and Search" FontWeight="Bold" FontSize="18" Margin="35, 0, 0, 0"/>
                                <TextBlock Text="Find Movie by Name"
                                           Margin="0, 12, 0 , 0"
                                           FontWeight="SemiBold"
                                           />
                                <TextBox
                                    Margin="0,4,0,0"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Disabled"
                                    Padding="0.5"
                                    Text="{Binding AppliedMovieNameFilter, UpdateSourceTrigger=PropertyChanged}"
                                    />
                                <Button
                                    Padding="4"
                                    Margin="0,8,0,0"
                                    Content="SEARCH / APPLY FILTERS"
                                    FontWeight="Bold"
                                    Background="#91FFA0"
                                    Command="{Binding ApplyFiltersCommand}"
                                    />
                                <TextBlock
                                    Text="Filters by Movie Genre"
                                    FontWeight="SemiBold"
                                    Margin="0,12,0,0"
                                    />

                                <RadioButton GroupName="MovieGenres" Content="FANTASY" Margin="0,4,0,0" FontWeight="SemiBold"
                                             IsChecked="{Binding AppliedGenreFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=FANTASY}"/>
                                <RadioButton GroupName="MovieGenres" Content="HORROR" Margin="0,4,0,0" FontWeight="SemiBold"
                                             IsChecked="{Binding AppliedGenreFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=HORROR}"/>
                                <RadioButton GroupName="MovieGenres" Content="DRAMA" Margin="0,4,0,0" FontWeight="SemiBold"
                                             IsChecked="{Binding AppliedGenreFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DRAMA}"/>
                                <RadioButton GroupName="MovieGenres" Content="ACTION" Margin="0,4,0,0" FontWeight="SemiBold"
                                             IsChecked="{Binding AppliedGenreFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ACTION}"/>
                                <RadioButton GroupName="MovieGenres" Content="COMEDY" Margin="0,4,0,0" FontWeight="SemiBold"
                                             IsChecked="{Binding AppliedGenreFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=COMEDY}"/>
                                <RadioButton GroupName="MovieGenres" Content="THRILLER" Margin="0,4,0,0" FontWeight="SemiBold"
                                             IsChecked="{Binding AppliedGenreFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=THRILLER}"/>
                                <RadioButton GroupName="MovieGenres" Content="ROMANCE" Margin="0,4,0,0" FontWeight="SemiBold"
                                             IsChecked="{Binding AppliedGenreFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ROMANCE}"/>
                                <RadioButton GroupName="MovieGenres" Content="SCI-FI" Margin="0,4,0,0" FontWeight="SemiBold"
                                             IsChecked="{Binding AppliedGenreFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=SCIENCE_FICITION}"/>

                                <TextBlock
                                    Text="Filter by author"
                                    FontWeight="SemiBold"
                                    Margin="0,12,0,0"
                                    />
                                
                                <ComboBox Margin="0,4,0,0" 
                                          ItemsSource="{Binding Authors}" 
                                          SelectedItem="{Binding AppliedAuthorFilter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <Separator Margin="0,20,0,15"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button Grid.Column="0"
                                            Padding="6"
                                            Content="➕ Author"
                                            FontWeight="SemiBold"
                                            FontSize="11"
                                            Background="#4CAF50"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Command="{Binding AddAuthorCommand}"
                                            Cursor="Hand"/>
                                    
                                    <Button Grid.Column="2"
                                            Padding="6"
                                            Content="➕ Movie"
                                            FontWeight="SemiBold"
                                            FontSize="11"
                                            Background="#4CAF50"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Command="{Binding AddMovieCommand}"
                                            Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Movies}" Margin="20">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" 
                                            BorderBrush="LightGray" 
                                            BorderThickness="1" 
                                            CornerRadius="8"
                                            Margin="10"
                                            Width="280"
                                            Height="340">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                                        </Border.Effect>
                                        
                                        <StackPanel>
                                            <!-- Movie Poster Placeholder -->
                                            <Border Background="Black" 
                                                    Height="160" 
                                                    CornerRadius="8,8,0,0">
                                                <Viewbox Width="80" Height="80">
                                                    <TextBlock Text="{Binding Title, Converter={StaticResource FirstLetterConverter}}" 
                                                               Foreground="#91FFA0" 
                                                               FontWeight="Bold" 
                                                               FontSize="48"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Viewbox>
                                            </Border>
                                            
                                            <!-- Movie Info -->
                                            <StackPanel Margin="15,10,15,10">
                                                <!-- Title -->
                                                <TextBlock Text="{Binding Title}" 
                                                           FontWeight="Bold" 
                                                           FontSize="18"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,5"/>
                                                
                                                <!-- TagLine -->
                                                <TextBlock Text="{Binding TagLine}" 
                                                           FontSize="12"
                                                           Foreground="Gray"
                                                           TextWrapping="Wrap"
                                                           Height="36"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,8"/>
                                                
                                                <!-- Author -->
                                                <TextBlock Margin="0,0,0,10">
                                                    <Run Text="Author: " Foreground="Gray" FontSize="11"/>
                                                    <Run Text="{Binding Author.LastName}" FontWeight="SemiBold" FontSize="11"/>
                                                </TextBlock>
                                                
                                                <!-- Action Buttons -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Button Grid.Column="0"
                                                            Content="Add Mark"
                                                            Background="#91FFA0"
                                                            BorderThickness="0"
                                                            Padding="8,6"
                                                            FontWeight="SemiBold"
                                                            FontSize="11"
                                                            Cursor="Hand"/>
                                                    
                                                    <Button Grid.Column="2"
                                                            Content="Edit"
                                                            Background="#91FFA0"
                                                            BorderThickness="0"
                                                            Padding="8,6"
                                                            FontWeight="SemiBold"
                                                            FontSize="11"
                                                            Cursor="Hand"
                                                            Command="{Binding DataContext.EditMovieCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Movie Marks">
                <!-- Second tab with movies which user had marked -->
                Hello MovieMarks!
            </TabItem>
            <TabItem Header="My Account">
                <!-- The last tab where user can change his own data -->
                Hello MyAccount Window!
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
 