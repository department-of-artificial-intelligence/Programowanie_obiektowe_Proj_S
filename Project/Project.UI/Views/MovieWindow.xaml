<Window x:Class="Project.UI.Views.MovieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Movie Editor" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="{Binding WindowTitle}" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"/>
            
            <!-- Title -->
            <TextBlock Text="Movie Title *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="8" 
                     FontSize="14"
                     Margin="0,0,0,15"/>
            
            <!-- Tag Line -->
            <TextBlock Text="Tag Line" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding TagLine, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="8" 
                     FontSize="14"
                     Margin="0,0,0,15"/>
            
            <!-- Description -->
            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="8" 
                     FontSize="14"
                     Height="100"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,15"/>
            
            <!-- Genre -->
            <TextBlock Text="Genre *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding AvailableGenres}"
                      SelectedItem="{Binding SelectedGenre}"
                      Padding="8"
                      FontSize="14"
                      Margin="0,0,0,15"/>
            
            <!-- Author -->
            <TextBlock Text="Author *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Authors}"
                      SelectedItem="{Binding SelectedAuthor}"
                      Padding="8"
                      FontSize="14"
                      Margin="0,0,0,25">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            
            <!-- Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0"
                        Content="Save"
                        Command="{Binding SaveCommand}"
                        Background="#91FFA0"
                        BorderThickness="0"
                        Padding="12"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"/>
                
                <Button Grid.Column="2"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Background="#FFB0B0"
                        BorderThickness="0"
                        Padding="12"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"/>
            </Grid>
            
            <!-- Delete Button (Only in Edit Mode) -->
            <Button Content="Delete Movie"
                    Command="{Binding DeleteCommand}"
                    Background="#FF4444"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="12"
                    FontSize="14"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Margin="0,15,0,0"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Border>
</Window>
