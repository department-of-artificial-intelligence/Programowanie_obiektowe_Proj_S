<Window x:Class="Project.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Project.UI.ViewModel"
        xmlns:local="clr-namespace:Project.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.DataContext>
        <viewmodels:MoviesViewModel/>
    </Window.DataContext>
    
    <DockPanel>
        <TabControl>
            <TabItem Header="Explore Movies">
                <!-- First tab with movies and filters -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            BorderBrush="Black"
                            BorderThickness="0, 0, 1.5, 0"
                    >

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" Padding="10">
                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Label Content="Filters and Search" FontWeight="Bold" FontSize="18" Margin="35, 0, 0, 0"/>
                                <TextBlock Text="Find Movie by Name"
                                           Margin="0, 12, 0 , 0"
                                           FontWeight="SemiBold"
                                           />
                                <TextBox
                                    Margin="0,4,0,0"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Disabled"
                                    Padding="0.5"
                                    Text="{Binding _appliedMovieNameFilter}"
                                    />
                                <Button
                                    Padding="4"
                                    Margin="0,8,0,0"
                                    Content="SEARCH / APPLY FILTERS"
                                    FontWeight="Bold"
                                    Background="#91FFA0"
                                    Command="{Binding applyFiltersCommand}"
                                    />
                                <TextBlock
                                    Text="Filters by Movie Genre"
                                    FontWeight="SemiBold"
                                    Margin="0,12,0,0"
                                    />

                                <RadioButton GroupName="MovieGanres" Content="FANTASY" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                <RadioButton GroupName="MovieGanres" Content="HORROR" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                <RadioButton GroupName="MovieGanres" Content="DRAMA" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                <RadioButton GroupName="MovieGanres" Content="ACTION" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                <RadioButton GroupName="MovieGanres" Content="COMEDY" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                <RadioButton GroupName="MovieGanres" Content="THRILLER" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                <RadioButton GroupName="MovieGanres" Content="ROMANCE" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                <RadioButton GroupName="MovieGanres" Content="SCI-FI" Margin="0,4,0,0" FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Filter by author"
                                    FontWeight="SemiBold"
                                    Margin="0,12,0,0"
                                    />

                                <!-- Initialize component with real data -->
                                <ComboBox Margin="0,4,0,0" Name="AuthorFilter">
                                    <ComboBoxItem IsSelected="True">Example 1</ComboBoxItem>
                                    <ComboBoxItem>Example 2</ComboBoxItem>
                                    <ComboBoxItem>Example 3</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <!-- Filtered cards with movies here -->
                    <DataGrid ItemsSource="{Binding Movies}" AutoGenerateColumns="True">
                        
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Movie Marks">
                <!-- Second tab with movies which user had marked -->
                Hello MovieMarks!
            </TabItem>
            <TabItem Header="My Account">
                <!-- The last tab where user can change his own data -->
                Hello MyAccount Window!
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
 